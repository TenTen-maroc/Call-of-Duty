# Force LF for text, and route every binary through Git LFS.
# Set this up BEFORE the first commit. Retrofitting LFS needs a history rewrite.
# Run once:  git lfs install

* text=auto eol=lf

# Unity YAML — text, and use UnityYAMLMerge for conflicts
*.unity     text eol=lf merge=unityyamlmerge diff
*.prefab    text eol=lf merge=unityyamlmerge diff
*.asset     text eol=lf merge=unityyamlmerge diff
*.mat       text eol=lf merge=unityyamlmerge diff
*.anim      text eol=lf merge=unityyamlmerge diff
*.controller text eol=lf merge=unityyamlmerge diff
# An AudioMixer is YAML like every other Unity asset, and it is the ONE asset in
# this project that a human authors by hand (AudioMixerController is internal to
# UnityEditor, so no builder can make one). Listed here so the file a human drops
# in lands with LF endings and a mergeable diff like everything a builder writes.
*.mixer     text eol=lf merge=unityyamlmerge diff
*.meta      text eol=lf
*.cs        text eol=lf diff=csharp
*.shader    text eol=lf
*.md        text eol=lf

# 3D models
*.fbx  filter=lfs diff=lfs merge=lfs -text
*.obj  filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.dae  filter=lfs diff=lfs merge=lfs -text
*.3ds  filter=lfs diff=lfs merge=lfs -text

