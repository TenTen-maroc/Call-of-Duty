# Unity — generated, never commit. Library/ alone is multiple GB.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
.vsconfig

# Never ignore these — the project is unopenable without them:
#   Assets/  Packages/  ProjectSettings/

# IDE / solution files — regenerated by Unity on open
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Build outputs
*.apk
*.aab
*.unitypackage
*.app
*.exe
crashlytics-build.properties
sysinfo.txt

# Addressables cache
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
ServerData/

# Asset Store tooling
/[Aa]ssets/AssetStoreTools*

# OS noise
.DS_Store
Thumbs.db

# Local secrets (Steam keys, signing, API tokens) — placeholders only in .env.template
.env
.env.local
